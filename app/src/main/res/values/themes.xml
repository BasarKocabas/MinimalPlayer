<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MinimalPlayer" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Main Backgrounds -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>

        <!-- Surface / Elevation Colors -->
        <item name="colorSurface">@color/elevated_surface</item>
        <item name="android:colorBackgroundFloating">@color/elevated_surface</item>

        <!-- Accent: single blue everywhere (tab indicator/text, FAB, etc.) -->
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryVariant">@color/accent_blue_dark</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/accent_blue_dark</item>
        <item name="colorAccent">@color/accent_blue</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Dividers -->
        <item name="android:listDivider">@color/dividers</item>

        <!-- Larger Texts for Dialogs and Menus -->
        <item name="android:itemTextAppearance">@style/LargeMenuText</item>
        <item name="materialAlertDialogTheme">@style/LargeDialogTheme</item>
    </style>

    <style name="LargeMenuText" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textSize">18sp</item>
    </style>
    
    <style name="LargeDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="textAppearanceHeadline6">@style/LargeDialogTitle</item>
        <item name="textAppearanceBody2">@style/LargeDialogBody</item>
    </style>
    
    <style name="LargeDialogTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">22sp</item>
    </style>
    
    <style name="LargeDialogBody" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">18sp</item>
    </style>
</resources>
